# .env.example — every variable used by the Makefile and scripts, with placeholders.
#
#   make env      copies this file to .env (chmod 600, gitignored) and fills the
#                 self-generated secrets with random values.
#   make seal     turns the secrets in .env into SealedSecret manifests under gitops/.
#
# Never put real values in this file. Values equal to CHANGE_ME are treated as unset.

# --- Repository and cluster (not secret) -------------------------------------
GITHUB_OWNER=andrea-claro
GITOPS_REPO_URL=https://github.com/andrea-claro/integration-platform-lab.git
GITOPS_REVISION=main
KUBE_CONTEXT=k3d-ipl
# Cloudflare zone of the public hostnames status.<domain> and api.<domain>.
# The tunnel itself is the connector already running on the Mac: no token here.
PUBLIC_DOMAIN=example.com

# --- Self-generated secrets: `make env` fills these with random values -------
# Demo key published with the API docs (tight rate limit) and a private admin key
TELEMETRY_API_DEMO_KEY=CHANGE_ME
TELEMETRY_API_ADMIN_KEY=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Mosquitto credentials (one user per client)
MQTT_SIMULATOR_PASSWORD=CHANGE_ME
MQTT_BRIDGE_PASSWORD=CHANGE_ME
